<launch>
    <node pkg="motor_can" type="motor_canopen.py" name="motor_can_node" output="screen">
        <!-- <param name="servo_config" value="$(find motor_can)/config/servo_config.yaml"/> -->
        <!-- <param name="can_interface" value="can0"/> -->
    </node>
    <node pkg="robot_mqtt" type="mqtt_test.py" name="mqtt_test_node" >
        <param name="broker" value="121.40.57.48"/>
        <param name="port" value="8883"/>
        <param name="user" value="gf-mounted"/>
        <param name="passward" value="20230810"/>
        <param name="topic_status" value="robot/001/status"/>
        <param name="topic_cmd" value="robot/001/cmd"/>
        <param name="client_id" value="python-mqtt-client-v2"/>
    </node>
    <node pkg="serial_comms" type="distance_publisher_node.py" name="distance_publisher_node" output="screen">
        <!-- <param name="port" value="/dev/SENSOR0"/> -->
        <!-- <param name="baudrate" value="115200"/> -->
    </node>    
    <!-- <node pkg="serial_comms" type="distance_can.py" name="distance_can" output="screen"> -->
    <!-- </node> -->
    <node pkg="serial_comms" type="imu_inspvae.py" name="imu_inspvae" output="screen" />
</launch>