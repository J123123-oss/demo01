[Unit]
Description=Network Monitor Service (Delayed 1 minute)
After=network.target
Wants=network.target

[Service]
# 延时60秒启动（确保系统初始化完成）
ExecStartPre=/bin/sleep 60
# 执行脚本（不在这里写重定向）
ExecStart=/home/orangepi/demo01/network_monitor.sh
User=root
# 标准输出和错误输出重定向到日志文件
StandardOutput=append:/home/orangepi/demo01/network_monitor.log
StandardError=append:/home/orangepi/demo01/network_monitor.log
# 脚本退出后自动重启（增强稳定性）
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target